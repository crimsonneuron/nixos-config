# greeter.nix
#
# greetd + ReGreet, hosted in a throwaway niri instance instead of cage or the
# kernel console. Because it's niri, every output is configured explicitly by
# name (mode, scale, position, which one gets the prompt), so it no longer
# matters which monitor the kernel happens to probe first.
#
# Usage:
#   imports = [ ./greeter.nix ];
#   my.greeter = {
#     enable = true;
#     outputs."DP-1"     = { scale = 1.5; position = { x = 0;    y = 0; }; focus = true; };
#     outputs."HDMI-A-1" = { scale = 1;   position = { x = 2560; y = 0; }; };
#   };
{ config, lib, pkgs, ... }:

let
  inherit (lib) mkEnableOption mkOption mkIf types;

  cfg = config.my.greeter;
  niri = config.programs.niri.package;
  regreet = config.programs.regreet.package;
  xkb = config.services.xserver.xkb;

  # JSON string escaping is also valid KDL string escaping.
  q = builtins.toJSON;

  outputType = types.submodule {
    options = {
      enable = mkOption {
        type = types.bool;
        default = true;
        description = "Whether this output is on in the greeter. Set false to blank it.";
      };
      mode = mkOption {
        type = types.nullOr types.str;
        default = null;
        example = "3840x2160@144";
        description = "WIDTHxHEIGHT or WIDTHxHEIGHT@REFRESH.";
      };
      scale = mkOption {
        type = types.nullOr (types.either types.int types.float);
        default = null;
        example = 1.5;
        description = "Output scale. If null, niri guesses one, which is what you're trying to avoid.";
      };
      transform = mkOption {
        type = types.nullOr (types.enum [
          "normal" "90" "180" "270"
          "flipped" "flipped-90" "flipped-180" "flipped-270"
        ]);
        default = null;
      };
      position = mkOption {
        type = types.nullOr (types.submodule {
          options = {
            x = mkOption { type = types.int; };
            y = mkOption { type = types.int; };
          };
        });
        default = null;
        example = { x = 0; y = 0; };
        description = "Position in logical (post-scale) pixels.";
      };
      focus = mkOption {
        type = types.bool;
        default = false;
        description = "Put the login prompt on this output (niri's focus-at-startup).";
      };
    };
  };

  renderOutput = name: o:
    let
      body =
        if !o.enable then [ "off" ]
        else
          lib.optional (o.mode != null) "mode ${q o.mode}"
          ++ lib.optional (o.scale != null) "scale ${toString o.scale}"
          ++ lib.optional (o.transform != null) "transform ${q o.transform}"
          ++ lib.optional (o.position != null)
               "position x=${toString o.position.x} y=${toString o.position.y}"
          ++ lib.optional o.focus "focus-at-startup";
    in ''
      output ${q name} {
      ${lib.concatMapStrings (l: "    ${l}\n") body}}
    '';

  # Reuse the system keyboard layout so your password types the same way.
  xkbFields = lib.concatStringsSep "; " (
    [ "layout ${q xkb.layout}" ]
    ++ lib.optional (xkb.variant != "") "variant ${q xkb.variant}"
    ++ lib.optional (xkb.options != "") "options ${q xkb.options}"
  );

  niriConfig = pkgs.writeTextFile {
    name = "niri-greeter.kdl";
    text = ''
      // Generated by greeter.nix. This niri instance only hosts ReGreet.
      // There is deliberately no `binds` block, so the greeter has no
      // shortcuts (e.g. no spawning a terminal as the greeter user).
      // niri's built-in Ctrl+Alt+F<n> VT switching still works.

      ${lib.concatStrings (lib.mapAttrsToList renderOutput cfg.outputs)}
      input {
          keyboard {
              xkb { ${xkbFields}; }
              ${lib.optionalString cfg.numlock "numlock"}
          }
      }

      cursor {
          xcursor-theme ${q cfg.cursor.name}
          xcursor-size ${toString cfg.cursor.size}
      }

      // Stop GTK from waiting on portals that never start in the greeter session.
      environment {
          GTK_USE_PORTAL "0"
          GDK_DEBUG "no-portals"
      }

      hotkey-overlay {
          skip-at-startup
      }

      prefer-no-csd

      window-rule {
          open-fullscreen true
      }

      // When ReGreet exits (i.e. after a successful login), shut this niri
      // down so greetd can start your real session.
      spawn-sh-at-startup ${q "${lib.getExe regreet}; ${niri}/bin/niri msg action quit --skip-confirmation"}

      ${cfg.extraConfig}
    '';
    # Fail the build, not the login screen, if the config is invalid
    # (including if your niri is too old for an option used here).
    checkPhase = ''
      ${niri}/bin/niri validate --config "$target"
    '';
  };

  session = pkgs.writeShellScript "niri-greeter-session" ''
    export XCURSOR_PATH="${cfg.cursor.package}/share/icons''${XCURSOR_PATH:+:$XCURSOR_PATH}"
    exec ${pkgs.dbus}/bin/dbus-run-session ${niri}/bin/niri --config ${niriConfig}
  '';
in
{
  options.my.greeter = {
    enable = mkEnableOption "greetd + ReGreet running inside a dedicated niri instance";

    outputs = mkOption {
      type = types.attrsOf outputType;
      default = { };
      description = ''
        Per-output greeter config, keyed by connector name ("DP-1") or by
        "Make Model Serial" exactly as `niri msg outputs` prints it. The
        latter keeps working if you swap which port a monitor is plugged into.
        Outputs not listed here are left to niri's defaults.
      '';
    };

    numlock = mkOption {
      type = types.bool;
      default = false;
      description = "Turn Num Lock on in the greeter.";
    };

    cursor = {
      name = mkOption {
        type = types.str;
        default = "Adwaita";
      };
      size = mkOption {
        type = types.int;
        default = 24;
      };
      package = mkOption {
        type = types.package;
        default = pkgs.adwaita-icon-theme;
        defaultText = lib.literalExpression "pkgs.adwaita-icon-theme";
      };
    };

    extraConfig = mkOption {
      type = types.lines;
      default = "";
      description = "Extra KDL appended to the greeter's niri config.";
    };
  };

  config = mkIf cfg.enable {
    assertions = [
      {
        assertion = lib.count (o: o.focus) (lib.attrValues cfg.outputs) <= 1;
        message = "my.greeter.outputs: at most one output can have focus = true.";
      }
    ];

    programs.niri.enable = lib.mkDefault true;

    # Enables greetd and provides /etc/greetd/regreet.{toml,css} plus ReGreet's
    # state/log dirs. Theme it via programs.regreet.* as usual. Its default
    # cage-based command is set with mkDefault, so the line below replaces it.
    programs.regreet.enable = true;

    services.greetd.settings.default_session.command = "${session}";
  };
}
